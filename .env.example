# Runtime identity: local | test | preview | staging | production
APP_ENV=local
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Required only after the related foundation is configured.
DATABASE_URL=postgresql://autobros:autobros@localhost:5432/autobros
AUTH_SECRET=
AUTH_SHOP_SLUG=auto-bros-garage
OBJECT_STORAGE_BUCKET=
OPENAI_API_KEY=

# AI model provider. Without a key, AI features stay visibly off (see docs/ai-provider.md).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5; claude-sonnet-5 and claude-haiku-4-5 cost less.
AI_MODEL=
